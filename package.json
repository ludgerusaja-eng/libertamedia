{
  "name": "libertamedia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server.production.ts",
    "build": "vite build && esbuild server.production.ts --bundle --platform=node --format=cjs --external:fsevents --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:api": "tsx scripts/api_contract_check.ts",
    "check:launch": "bash scripts/launch_gate.sh",
    "generate:feeds": "tsx scripts/generate_feeds.ts",
    "migrate:mysql": "tsx scripts/migrate_json_to_mysql.ts",
    "seed:admin": "tsx scripts/seed_admin.ts",
    "publish:scheduled": "tsx scripts/publish_scheduled.ts",
    "smoke:production": "tsx scripts/production_smoke_test.ts",
    "smoke:http": "bash scripts/http_smoke_test.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "tsx": "^4.20.3"
  }
}
