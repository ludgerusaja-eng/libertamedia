# 1. Disable Node.js Passenger khusus subdomain ini
<IfModule mod_passenger.c>
    PassengerEnabled Off
</IfModule>

# 2. Force Explicit LiteSpeed PHP Handler (LSPHP)
<IfModule LiteSpeed>
    AddHandler application/x-httpd-ea-php82 .php
</IfModule>

# 3. WordPress Standard Rewrites & REST API Authorization Bypass
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# 4. CORS Headers untuk REST API Access dari Main Domain React
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://libertamedia.com"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
    Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
    Header set Access-Control-Allow-Credentials "true"
</IfModule>
