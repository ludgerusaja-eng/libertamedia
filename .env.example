# LIBERTAMEDIA production environment template
# NEVER commit the real .env file or production secrets.
NODE_ENV=production
PORT=3000
APP_URL=https://libertamedia.com

# Database: production must use MySQL
DATABASE_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME

# Authentication: REQUIRED in production; generate long random values.
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional integrations
GEMINI_API_KEY=CHANGE_ME
VITE_WP_API_URL=
WP_BASE_URL=

# Upload limits
UPLOAD_MAX_SIZE=5242880

# Storage
DATA_DIR=/home/CHANGE_ME/data
