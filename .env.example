# LIBERTAMEDIA production environment template
# NEVER commit the real .env file or production secrets.
NODE_ENV=production
PORT=3000
APP_URL=https://libertamedia.com

# Database: production must use MySQL
DATABASE_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=CHANGE_ME
DB_CONNECTION_LIMIT=10

# Authentication: user credentials live in MySQL, not in .env.
# Run npm run seed:admin once after setting these values securely.
ADMIN_EMAIL=redaksi@libertamedia.com
ADMIN_NAME=Dewan Redaksi

# Optional integrations
GEMINI_API_KEY=CHANGE_ME
VITE_WP_API_URL=
WP_BASE_URL=

# Upload limits
UPLOAD_MAX_SIZE=10485760

# Storage
DATA_DIR=/home/CHANGE_ME/data
