# DO NOT REMOVE OR MODIFY - CPANEL PHUSION PASSENGER CONFIGURATION
<IfModule mod_passenger.c>
  PassengerEnabled On
  PassengerAppType node
  PassengerStartupFile app.js
</IfModule>

# Apache Rewrite Rules for libertamedia.com (cPanel Node.js / Phusion Passenger Routing)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct static access ONLY for real asset files in assets/ or public files
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} ^/(assets|favicon|uploads|images|media)/ [NC]
  RewriteRule ^ - [L]
</IfModule>
